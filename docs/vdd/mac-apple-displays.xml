<?xml version="1.0" encoding="UTF-8"?>
<!-- MTT VDD 25.7.23. Save as C:\VirtualDisplayDriver\vdd_settings.xml. -->
<!-- 10 modes; budget: 90 modes. Count every resolution x refresh combination. -->
<!-- Coverage, omissions and sources: ../VIRTUAL_DISPLAY_MODES.md. Setup: ../HOST_SETUP.md. -->
<vdd_settings>
    <monitors><count>1</count></monitors>
    <!-- Automatic GPU selection; an existing adapter.txt takes precedence. -->
    <gpu><friendlyname>default</friendlyname></gpu>
    <!-- Global rates multiply the mode count. Keep empty to stay within budget. -->
    <global />
    <resolutions>
        <resolution>
            <width>5120</width><height>2880</height>
            <refresh_rate>60</refresh_rate><refresh_rate>120</refresh_rate>
        </resolution>
        <resolution>
            <width>2560</width><height>1440</height>
            <refresh_rate>60</refresh_rate><refresh_rate>120</refresh_rate>
        </resolution>
        <resolution>
            <width>6016</width><height>3384</height>
            <refresh_rate>48</refresh_rate><refresh_rate>50</refresh_rate><refresh_rate>60</refresh_rate>
        </resolution>
        <resolution>
            <width>3008</width><height>1692</height>
            <refresh_rate>48</refresh_rate><refresh_rate>50</refresh_rate><refresh_rate>60</refresh_rate>
        </resolution>
    </resolutions>
    <logging>
        <SendLogsThroughPipe>false</SendLogsThroughPipe>
        <logging>false</logging><debuglogging>false</debuglogging>
    </logging>
    <colour>
        <SDR10bit>false</SDR10bit><HDRPlus>false</HDRPlus>
        <ColourFormat>RGB</ColourFormat>
    </colour>
    <cursor>
        <HardwareCursor>true</HardwareCursor>
        <CursorMaxX>128</CursorMaxX><CursorMaxY>128</CursorMaxY>
        <AlphaCursorSupport>true</AlphaCursorSupport>
        <XorCursorSupportLevel>2</XorCursorSupportLevel>
    </cursor>
    <edid>
        <CustomEdid>false</CustomEdid><PreventSpoof>false</PreventSpoof>
        <EdidCeaOverride>false</EdidCeaOverride>
    </edid>
</vdd_settings>
