// Single source of truth for the app version (MARKETING_VERSION +
// CURRENT_PROJECT_VERSION). Pulled in here so the Makefile's single
// `-xcconfig` flag supplies the version to the build.
#include "Version.xcconfig"

// Xcode build settings for the one C library the Swift engine links (Homebrew Opus).
// Applied via `xcodebuild -xcconfig` from the Makefile, which injects
// OPUS_PREFIX = $(brew --prefix opus), so the pbxproj carries no absolute paths.

// SRCROOT = repo root (directory containing Glimmer.xcodeproj).
GLIMMER_REPO_ROOT = $(SRCROOT)

// Repo root for our own headers (CHelpers.h, imported via the bridging header) + Opus.
HEADER_SEARCH_PATHS = $(inherited) $(GLIMMER_REPO_ROOT) $(OPUS_PREFIX)/include

LIBRARY_SEARCH_PATHS = $(inherited) $(OPUS_PREFIX)/lib

OTHER_LDFLAGS = $(inherited) -lopus

// Apple Silicon only. Homebrew's opus is arm64-only, so a universal
// (arm64 + x86_64) link fails on the x86_64 slice with undefined Opus symbols.
// Pin arm64 so the Release build - which otherwise defaults to ARCHS_STANDARD
// (universal) - stays arm64-only, matching the shipped binaries. (The committed
// shared scheme doesn't carry the auto-scheme's run-destination arch narrowing.)
ARCHS = arm64

// Bridging header at repo root (where Xcode looks by convention).
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/Glimmer-Bridging-Header.h
