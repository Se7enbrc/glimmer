// Single source of truth for the app version (MARKETING_VERSION +
// CURRENT_PROJECT_VERSION). Pulled in here so the Makefile's single
// `-xcconfig` flag supplies the version to the build.
#include "Version.xcconfig"

// Pin Mac builds to Apple Silicon; framework Simulator builds retain the SDK's standard architectures.
ARCHS[sdk=macosx*] = arm64

// Reproducible Release payload (docs/RELEASE.md): once the dSYM is written, strip the
// stabs that record checkout paths. The symbol table stays, so crash logs still name
// functions without a dSYM.
DEPLOYMENT_POSTPROCESSING[config=Release] = YES
STRIP_STYLE[config=Release] = debugging
STRIP_SWIFT_SYMBOLS[config=Release] = NO

// Apply Enhanced Security's compiler protections explicitly while retaining arm64.
// Pointer authentication requires a separately validated arm64e dependency build.
CLANG_ENABLE_STACK_ZERO_INIT = YES
ENABLE_SECURITY_COMPILER_WARNINGS = YES
GCC_WARN_SHADOW = YES
CLANG_WARN_EMPTY_BODY = YES
CLANG_ENABLE_C_TYPED_ALLOCATOR_SUPPORT = YES
CLANG_ENABLE_CPLUSPLUS_TYPED_ALLOCATOR_SUPPORT = YES
