<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- SMAppService's root AWDL helper requires an unsandboxed app.
	     Hardened Runtime and library validation remain enabled; see docs/SECURITY.md. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<!-- Hardened Runtime: no JIT. -->
	<key>com.apple.security.cs.allow-jit</key>
	<false/>

	<!-- AVAudioEngine applies AirPods head orientation and the user's spatial profile. -->
	<key>com.apple.developer.coremotion.head-pose</key>
	<true/>
	<key>com.apple.developer.spatial-audio.profile-access</key>
	<true/>

	<!-- Pin version 1 until the streaming workload has been profiled with guard objects.
	     Integer keys cover macOS 26.0; string keys cover macOS 26.4 and later. -->
	<key>com.apple.security.hardened-process</key>
	<true/>
	<key>com.apple.security.hardened-process.enhanced-security-version</key>
	<integer>1</integer>
	<key>com.apple.security.hardened-process.enhanced-security-version-string</key>
	<string>1</string>
	<key>com.apple.security.hardened-process.hardened-heap</key>
	<true/>
	<key>com.apple.security.hardened-process.platform-restrictions</key>
	<integer>2</integer>
	<key>com.apple.security.hardened-process.platform-restrictions-string</key>
	<string>2</string>
	<key>com.apple.security.hardened-process.dyld-ro</key>
	<true/>
</dict>
</plist>
