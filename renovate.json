{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigestsToSemver"],
  "dependencyDashboard": true,
  "automerge": false,
  "timezone": "America/New_York",
  "schedule": ["before 9am on monday"],
  "separateMajorMinor": false,
  "separateMultipleMajor": false,
  "separateMinorPatch": false,
  "prConcurrentLimit": 1,
  "branchConcurrentLimit": 1,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Sparkle, pinned outside a Package.swift: build tools, notices and the resolved package",
      "managerFilePatterns": [
        "/^Makefile$/",
        "/^scripts/sparkle-tools\\.sh$/",
        "/^Glimmer/ThirdPartyNotices\\.txt$/"
      ],
      "matchStrings": [
        "SPARKLE_VERSION \\?= (?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "SPARKLE_VERSION=\"\\$\\{SPARKLE_VERSION:-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\}\"",
        "Sparkle (?<currentValue>\\d+\\.\\d+\\.\\d+)\\n",
        "sparkle-project/Sparkle/blob/(?<currentValue>\\d+\\.\\d+\\.\\d+)/LICENSE"
      ],
      "matchStringsStrategy": "any",
      "depNameTemplate": "sparkle-project/Sparkle",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Sparkle's resolved revision and version in the Xcode workspace",
      "managerFilePatterns": [
        "/^Glimmer\\.xcodeproj/project\\.xcworkspace/xcshareddata/swiftpm/Package\\.resolved$/"
      ],
      "matchStrings": [
        "\"location\" : \"https://github\\.com/sparkle-project/Sparkle\",\\s*\"state\" : \\{\\s*\"revision\" : \"(?<currentDigest>[0-9a-f]{40})\",\\s*\"version\" : \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "sparkle-project/Sparkle",
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "description": "Keep Python on 3.14 until PyYAML publishes 3.15 wheels for locked, wheel-only installs.",
      "matchManagers": ["mise"],
      "matchPackageNames": ["python/cpython"],
      "allowedVersions": "<3.15"
    },
    {
      "matchPackageNames": ["*"],
      "groupName": "dependencies",
      "groupSlug": "all",
      "commitMessagePrefix": "build(deps):"
    },
    {
      "description": "Keep macOS 15 as the oldest-supported compatibility test runner.",
      "matchManagers": ["github-actions"],
      "matchDatasources": ["github-runners"],
      "matchPackageNames": ["macos"],
      "matchCurrentValue": "/^15$/",
      "enabled": false
    },
    {
      "matchPackageNames": ["sparkle-project/Sparkle"],
      "prBodyNotes": [
        "Sparkle changed. Verify the new `Sparkle-<version>.tar.xz` release archive and add its SHA-256 to `scripts/sparkle-tools.sh` (the release-tool tests fail until you do), and check `Glimmer/ThirdPartyNotices.txt` against the new LICENSE."
      ]
    }
  ],
  "mise": {
    "enabled": true
  }
}
